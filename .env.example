# =============================================================================
# DataShare - Variables d'environnement (Docker Compose)
# Copier ce fichier en `.env` a la racine du repo, puis adapter les valeurs.
# Le fichier `.env` est ignore par Git : ne jamais commiter de secrets.
# =============================================================================

# --- PostgreSQL (service `db`) ---
POSTGRES_DB=datashare
POSTGRES_USER=datashare
POSTGRES_PASSWORD=datashare

# --- API ASP.NET Core (service `api`) ---
# Les cles `Section__Cle` sont lues par ASP.NET Core comme `Section:Cle`.
# Cle de signature des JWT : chaine aleatoire d'au moins 32 caracteres (HMAC-SHA256).
# Generation : openssl rand -base64 48   (ou [Convert]::ToBase64String((1..48|%{Get-Random -Max 256})) en PowerShell)
JWT_KEY=change-me-in-production-secret-key-32chars
JWT_ISSUER=DataShareApi
JWT_AUDIENCE=DataShareClient

# Origines autorisees pour CORS (utile uniquement si le front n'est pas servi
# par nginx en meme origine, ex. `npm run dev` sur http://localhost:5173).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (build Vite) ---
# `/api` = proxy nginx vers l'API (configuration Docker par defaut).
VITE_API_URL=/api
